// Render from the repo root with Graphviz:
// dot -Tpng -Gdpi=180 diagrams/M1_workflow_unrolled.dot -o images/M1_workflow_unrolled.png
// dot -Tpdf diagrams/M1_workflow_unrolled.dot -o diagrams/M1_workflow_unrolled.pdf
digraph M1 {
  graph [newrank=true, pad=.20, nodesep=.24, ranksep=.34, bgcolor="white", fontname="Arial",
         label="Do habit clusters retain a score gap within prior-GPA bands?", labelloc=t, fontsize=19];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11,
        color="#A9B8C4", fillcolor="#F5F8FA", margin=".13,.10"];
  edge [fontname="Arial", fontsize=10, color="#496175", arrowsize=.72];

  subgraph cluster1 {
    label="Iteration 1   ·   All students"; color="#9CB5C6"; style=rounded; margin=11;
    fontname="Arial Bold"; fontsize=14;
    d1 [label="DATA\n\n64,000 training students.\nStandardize five numeric habits.\nEncode and weight study environment.\nReserve 16,000 students for testing."];
    m1 [label="MODEL\n\nSelect K-means k with training elbow\nand silhouette curves. Fit a GMM\nwith the same k. Train PCA for\na two-dimensional view."];
    v1 [label="VISUALIZE AND TEST\n\nPlot PCA, mean habit profiles and score\nboxes for held-out labels. Test scores\nwith Kruskal–Wallis and an effect size.\nTabulate cluster × prior-GPA band."];
    {rank=same; d1; m1; v1;}
    d1 -> m1 -> v1;
  }
  k1 [label="INFERENCE   ·   Global K-means gap = +4.15 exam points. The higher-study cluster\nhas 46% GPA-4.0 students, versus 32% in the lower-study cluster.", fillcolor="#E5EFF6",color="#527895"];
  v1 -> k1;
  t [label="TRANSFORM   ·   Split train and test students into the same four prior-GPA bands.\nRefit the numeric scales, environment weights, PCA and both cluster models in each training band.",
     fillcolor="#FFF1E8",color="#B95A30"];
  k1 -> t [label="Feedback loop", fontname="Arial Bold", color="#AD4726", fontcolor="#AD4726",penwidth=2];
  subgraph cluster2 {
    label="Iteration 2   ·   Within each prior-GPA band"; color="#9CB5C6"; style=rounded; margin=11;
    fontname="Arial Bold"; fontsize=14;
    d2 [label="DATA AND MODEL\n\nKeep the same six habit inputs.\nUse each band's training curves to\nselect k (all four chose 2). Predict\nlabels for that band's test students."];
    v2 [label="VISUALIZE AND TEST\n\nRepeat PCA, heatmaps and score boxes\nwithin each band. Measure rank effects\nand correct band tests for multiplicity.\nContrast local gaps and bootstrap CIs."];
    k2 [label="INFERENCE\n\nWeighted K-means gap = +0.41 points\n(95% CI +0.24 to +0.58); GMM = −0.35.\nLocal labels depend on the model.\nNeither gap identifies a causal effect.",fillcolor="#E5EFF6",color="#527895"];
    {rank=same; k2; v2; d2;}
    k2 -> v2 -> d2 [dir=back];
  }
  t -> d2;
  d1 -> k2 [style=invis, weight=20];
  m1 -> v2 [style=invis, weight=20];
}
