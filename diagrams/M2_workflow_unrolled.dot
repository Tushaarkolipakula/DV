digraph Dropout {
  graph [rankdir=TB, nodesep=.26, ranksep=.48, bgcolor="white", pad=.16];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13,
        color="#91A6B3", fillcolor="#EEF4FC", margin=".16,.13"];
  edge [fontname="Helvetica-Bold", fontsize=12, color="#52514e"];
  data [label="Shared split\n64,000 train · 16,000 test"];
  first [label="Fit weighted classifiers\nLogistic, tree and forest"];
  inspect [label="Inspect PR, ROC and tree\nTree AP 1.000 · exact rule", fillcolor="#FFF1E8"];
  {rank=same; data; first; inspect}
  data -> first -> inspect;
  remove [label="Remove stress and motivation\nAnxiety already excluded", fillcolor="#FDECEC"];
  refit [label="Refit all three models\nSame students and weights"];
  residual [label="Compare PR and shuffle predictors\nAP 0.043–0.075 · baseline 0.020\nGPA and mental health lead", fillcolor="#E8F7F1"];
  {rank=same; residual; refit; remove}
  inspect -> remove [label="Feedback loop", color="#AD4726", fontcolor="#AD4726", penwidth=2];
  residual -> refit -> remove [dir=back];
  data -> residual [style=invis];
}
