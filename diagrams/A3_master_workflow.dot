// Render from the repo root with Graphviz:
// dot -Tpng -Gdpi=170 diagrams/A3_master_workflow.dot -o images/A3_master_workflow.png
// dot -Tpdf diagrams/A3_master_workflow.dot -o diagrams/A3_master_workflow.pdf
digraph A3 {
  graph [newrank=true, pad=.22, nodesep=.30, ranksep=.27, bgcolor="white", fontname="Arial",
         label="How the three analyses use the same students", labelloc=t, fontsize=20];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11,
        color="#A9B8C4", fillcolor="#F5F8FA", margin=".14,.10", penwidth=1.1];
  edge [fontname="Arial", fontsize=10, color="#496175", arrowsize=.70];

  source [label="A1 cleaned data   ·   80,000 students\nRemove three redundant fields and flag score/GPA ceilings. Stratify 80/20 (seed 42),\nthen learn one-hot categories and numeric scales on the 64,000 training students.",
          fillcolor="#E5EFF6", color="#527895"];

  subgraph cluster_h {
    label="Tushaar   ·   Habits"; fontname="Arial Bold"; fontsize=15;
    style="rounded"; color="#91A6B3"; margin=12;
    h1 [label="PASS 1   ·   All GPA bands\n\nFit K-means and GMM to habits. Select k\nwith elbow and silhouette. Compare PCA maps,\nprofile heatmaps and held-out score boxes.\nGPA 4.0: 46% vs 32% by K-means cluster."];
    ht [label="Split each cohort by prior GPA.\nFit a new scaler and both models\ninside each training band.", fillcolor="#FFF1E8",color="#B95A30"];
    h2 [label="PASS 2   ·   Four independent fits\n\nRepeat maps, profiles and score boxes.\nMeasure score differences and effect sizes.\nK-means gap falls from +4.15 to +0.41\npoints. GMM refits give −0.35 points."];
    h1 -> ht [label="Feedback loop", fontname="Arial Bold", color="#AD4726", fontcolor="#AD4726",penwidth=2];
    ht -> h2;
  }
  subgraph cluster_w {
    label="Advaya   ·   Wellbeing"; fontname="Arial Bold"; fontsize=15;
    style="rounded"; color="#91A6B3"; margin=12;
    w1 [label="PASS 1   ·   Classify dropout risk\n\nFit logistic regression, tree and forest.\nInspect precision–recall, ROC and tree splits.\nStress and motivation reconstruct the flag: \nthe initial models have label leakage."];
    wt [label="Remove stress and motivation,\nthe two inputs used to define\nthe dropout flag.", fillcolor="#FFF1E8",color="#B95A30"];
    w2 [label="PASS 2   ·   Refit classifiers\n\nCompare precision–recall with the initial\nmodels and base rate. Inspect permutation\nimportance and proxy features.\nFigures and interpretation: Advaya."];
    w1 -> wt [label="Feedback loop", fontname="Arial Bold", color="#AD4726", fontcolor="#AD4726",penwidth=2];
    wt -> w2;
  }
  subgraph cluster_b {
    label="Aman   ·   Background"; fontname="Arial Bold"; fontsize=15;
    style="rounded"; color="#91A6B3"; margin=12;
    b1 [label="PASS 1   ·   Model exam score\n\nFit OLS and gradient boosting. Inspect\nresiduals and observed vs predicted scores.\nGPA dominates the fit; score and GPA\nboth have sizeable ceiling groups."];
    bt [label="Refit below the GPA ceiling.\nTest the tutoring association\nwith prior GPA as a covariate.", fillcolor="#FFF1E8",color="#B95A30"];
    b2 [label="PASS 2   ·   Examine adjusted associations\n\nFit median regression below the GPA cap.\nCompare ANOVA and GPA-adjusted ANCOVA\non the training cohort. Chart coefficients\nand tutoring gaps. Interpretation: Aman."];
    b1 -> bt [label="Feedback loop", fontname="Arial Bold", color="#AD4726", fontcolor="#AD4726",penwidth=2];
    bt -> b2;
  }
  {rank=same; h1; w1; b1;}
  {rank=same; ht; wt; bt;}
  {rank=same; h2; w2; b2;}
  source -> {h1 w1 b1};
  synthesis [label="TEAM SYNTHESIS   ·   Compare the evidence for habits, wellbeing and background\nInterpret all three strands in light of GPA, label definitions and score ceilings.", fillcolor="#E5EFF6",color="#527895"];
  {h2 w2 b2} -> synthesis;
}
