// Member 3 (Aman Kumar Lahoti): exam score - Keim visual analytics diamond,
// unrolled into two iterations
digraph M3 {
    rankdir=TB; newrank=true; splines=spline; nodesep=0.45; ranksep=0.52;
    bgcolor="#fcfcfb"; pad="0.45,0.35"; margin="0.15";
    node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10,
          color="#8a8985", fillcolor="white", penwidth=1.2, margin="0.20,0.12"];
    edge [fontname="Arial", fontsize=8.5, color="#52514e", fontcolor="#52514e",
          penwidth=1.2];
    label="Member 3 (Aman Kumar Lahoti): Exam score — Keim visual analytics diamond, unrolled into two iterations";
    labelloc=t; labeljust=c; fontname="Arial Bold"; fontsize=13;

    subgraph cluster_it1 {
        label="Iteration 1"; fontname="Arial Bold"; fontsize=11;
        style="rounded,dashed"; color="#b9b8b3"; margin=16;
        D1 [label="DATA D1\nTrain split (64,000)\n22 predictors\n(GPA + 21 features)\ntarget: raw exam score", fillcolor="#eef4fc", color="#2a78d6"];
        V1 [label="VISUALIZE\nscore vs prior GPA\n(A1 Fig 25)", fillcolor="#fff4e5", color="#eda100"];
        M1 [label="MODEL\nOLS (HC3) +\ngradient boosting", fillcolor="#e8f7f1", color="#1baf7a"];
        V1b [label="VISUALIZE MODEL\nPredicted vs actual fit\nOLS residuals vs fitted\nStandardised OLS slopes", fillcolor="#fff4e5", color="#eda100"];
        K1 [label="KNOWLEDGE K1\n• Prior GPA dominates (23.35 pts/unit)\n• Ceiling edge at 100 − fitted (25.7%)\n• 39.9% capped at GPA 4.0; non-GPA p > 0.05", fillcolor="#f3f0fb", color="#6250d6"];
        D1 -> V1 [label="mapping"];
        V1 -> M1 [label="model\nbuilding"];
        M1 -> V1b [label="model\nvisualization"];
        V1b -> K1 [label="inference"];
        {rank=same; D1; V1; M1; V1b; K1;}
    }

    T [label="TRANSFORM\nT1: drop GPA = 4.0 rows (38,466 kept)\nT2: median regression (7.2% ceiling)\nT3: GPA as covariate (ANCOVA)", fillcolor="#fdecec", color="#e34948", penwidth=2, margin="0.22,0.12"];

    subgraph cluster_it2 {
        label="Iteration 2"; fontname="Arial Bold"; fontsize=11;
        style="rounded,dashed"; color="#b9b8b3"; margin=16;
        D2 [label="DATA D2\nMedian fit: GPA < 4 (38,466)\nANOVA / ANCOVA: all 64,000\nOutcome: observed exam score", fillcolor="#eef4fc", color="#2a78d6"];
        M2 [label="MODEL\nmedian regression +\nANOVA / ANCOVA", fillcolor="#e8f7f1", color="#1baf7a"];
        V2 [label="VISUALIZE\nMedian-reg forest plot\nTutoring gap by income\n(raw vs GPA-adjusted)", fillcolor="#fff4e5", color="#eda100"];
        K2 [label="KNOWLEDGE K2\n• Adjusted tutoring association near zero\n• Raw ANOVA p < 1e-100 (+2.8 pts)\n  → ANCOVA p = 0.43 (−0.03 pts)\n• Prior GPA: 3.662 vs 3.542", fillcolor="#f3f0fb", color="#6250d6"];
        D2 -> M2 [label="model\nbuilding"];
        M2 -> V2 [label="model\nvisualization"];
        V2 -> K2 [label="inference"];
        {rank=same; D2; M2; V2; K2;}
    }

    K1 -> T [label="    FEEDBACK LOOP", color="#e34948", fontcolor="#e34948", penwidth=2.6, fontsize=10, fontname="Arial Bold"];
    T -> D2 [label="    transformation", color="#e34948", fontcolor="#e34948", penwidth=2];
}
